{
  "name": "dsh-wsl-openfoam",
  "version": "1.2.0",
  "description": "Run OpenFOAM inside WSL from any DeepSeek Harness session, with a settings page.",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "test": "node test/host.test.mjs && node test/api.test.mjs && node test/workdir.test.mjs && node test/client.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "openfoam",
    "wsl",
    "cfd"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "os": [
    "win32"
  ]
}
